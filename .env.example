# === AI 同事系統 — 環境變數 ===
# 本 demo 完全不需要任何金鑰即可執行(npm install && npm run dev)。
# 以下皆為「未來接真服務」時才需要,現在全部是 mock,可留空。

# AI provider:mock(預設)| claude
AI_PROVIDER=mock
# ANTHROPIC_API_KEY=sk-ant-...

# LINE 推播(現以畫面預覽模擬)
# LINE_CHANNEL_TOKEN=

# Email 寄送(現以畫面預覽模擬)
# RESEND_API_KEY=

# Supabase(現以記憶體 seed store 模擬)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
